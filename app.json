{
  "expo": {
    "name": "NFC Doctor",
    "slug": "nfc-reader-write",
    "version": "1.3.0",
    "scheme": "nfcreaderwrite",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nfcreaderwrite.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "10300"
    },
    "android": {
      "package": "com.nfcreaderwrite.app",
      "adaptiveIcon": {
        "backgroundColor": "#e4defd",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 10300
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "This app uses NFC to read and write tags you hold near your iPhone.",
          "selectIdentifiers": [
            "D2760000850100",
            "D2760000850101"
          ],
          "systemCodes": [
            "12FC",
            "88B4"
          ],
          "includeNdefEntitlement": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#e9e8fd"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "26fe033d-604e-4836-9a3a-f16422cbd149"
      }
    },
    "owner": "kanishak11-cyber"
  }
}
